PORT=5000
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=garment_erp

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Uploaded files (order-format images, company logo, export checklist files)
# local = public/storage on this server; s3 = an S3-compatible bucket.
STORAGE_DRIVER=local
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
# Amazon S3 (Mumbai): S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com and S3_REGION=ap-south-1
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long a file link stays valid, in seconds
S3_URL_EXPIRES_SECONDS=300
